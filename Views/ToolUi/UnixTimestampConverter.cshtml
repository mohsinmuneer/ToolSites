@model ToolDefinition
<p>Enter a Unix timestamp, then select seconds or milliseconds.</p>
<form id="tool-inputs" class="batch-tool" novalidate>
  <label for="stamp">Unix timestamp</label>
  <input id="stamp" type="number" value="1704067200" min="-8640000000000000" max="8640000000000000" step="1" required>
  <label for="unit">Timestamp unit</label>
  <select id="unit"><option>Seconds</option><option>Milliseconds</option></select>
  <div class="row">
    <button type="submit">Calculate</button>
    <button class="secondary" type="reset">Reset</button>
  </div>
</form>
<p class="muted">Your input stays in your browser.</p>
<div id="out" class="result" aria-live="polite"></div>
<style>
.batch-tool { display: grid; gap: 4px; }
.batch-tool input, .batch-tool select, .batch-tool textarea { width: 100%; min-height: 44px; margin-bottom: 8px; }
.batch-tool textarea { font: inherit; resize: vertical; }
.batch-tool button { min-height: 44px; }
#out { overflow-wrap: anywhere; }
#qr-preview canvas { max-width: 100%; height: auto; }
</style>
<script>
function readNumber(id) {
  const field = $(id);
  if (!field.validity.valid || !Number.isFinite(field.valueAsNumber)) {
    throw new Error('Enter a valid value for ' + field.labels[0].textContent.toLowerCase() + '.');
  }
  return field.valueAsNumber;
}

function calculate() {
  const value = readNumber('stamp');
  const date = new Date($('unit').value === 'Seconds' ? value * 1000 : value);
  if (!Number.isFinite(date.getTime())) throw new Error('Enter a timestamp within the supported date range.');
  return ['UTC: ' + date.toISOString(), 'Local time: ' + date.toLocaleString()];
}

$('tool-inputs').addEventListener('submit', event => {
  event.preventDefault();
  try {
    show('out', calculate());
  } catch (error) {
    show('out', error.message, false);
  }
});

$('tool-inputs').addEventListener('reset', () => {
  $('out').textContent = '';
  });
</script>
