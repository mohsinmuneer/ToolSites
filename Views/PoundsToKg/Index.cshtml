@{
    var faqs = new List<FaqItem>
    {
        new("How many kg is 1 pound?", "About 0.4536 kg."),
        new("How many pounds is 1 kg?", "About 2.2046 pounds."),
        new("Is this the same as stone?", "No. A stone is 14 pounds.")
    };
}
<h1>@ViewData["H1"]</h1>
<div class="card">
<div class="row"><label>Pounds (lb) <input id="a" type="number" step="any" value="150" style="width:150px"></label>=<label>Kilograms (kg) <input id="b" type="number" step="any" value="" style="width:150px"></label></div><p class="muted">Type in either box. The other one updates instantly.</p><div id="out" class="result" aria-live="polite"></div>
</div>

<partial name="_AdSlot" model='"SlotTop"' />

<div class="card">
  <h2>How to use the Pounds to Kilograms Converter</h2>
  <p>Enter a weight in pounds to get kilograms, or enter kilograms to get pounds. The two boxes update each other.</p>
  <h2>About this tool</h2>
  <p>One pound is defined as exactly 0.45359237 kilograms. To convert pounds to kilograms multiply by 0.4536; to go the other way multiply kilograms by 2.2046. A quick estimate is to halve the pounds and subtract about 10%. Pounds are used in the United States for body weight, luggage and food, while most of the world uses kilograms.</p>
  <partial name="_Faq" model="faqs" />
</div>
<partial name="_RelatedTools" />

<script>
pair('a','b',v=>v*0.45359237,v=>v/0.45359237);

$('a').dispatchEvent(new Event('input'));
</script>
