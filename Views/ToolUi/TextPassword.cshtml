@model ToolDefinition
<div class="row"><label>Length <input id="len" type="range" min="8" max="64" value="16"> <span id="lv">16</span></label></div>
<div class="row">
  <label><input id="lo" type="checkbox" checked> a-z</label><label><input id="up" type="checkbox" checked> A-Z</label>
  <label><input id="di" type="checkbox" checked> 0-9</label><label><input id="sy" type="checkbox" checked> !@@#$%</label>
</div>
<div class="row"><input id="pw" type="text" readonly style="width:100%;font-family:monospace;font-size:18px">
<button id="go" type="button">Generate</button><button id="copy" type="button" class="secondary">Copy</button></div>
<div id="msg" class="muted"></div>
<script>
const sets = { lo: 'abcdefghijklmnopqrstuvwxyz', up: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', di: '0123456789', sy: '!@@#$%^&*()-_=+[]{};:,.?' };
$('len').oninput = () => { $('lv').textContent = $('len').value; };
function gen() {
  const on = Object.keys(sets).filter(k => $(k).checked); if (!on.length) { $('pw').value = ''; $('msg').textContent = 'Select at least one character type.'; return; }
  const len = parseInt($('len').value, 10), all = on.map(k => sets[k]).join('');
  const out = on.map(k => sets[k][randInt(sets[k].length)]);   // at least one of each type
  while (out.length < len) out.push(all[randInt(all.length)]);
  for (let i = out.length - 1; i > 0; i--) { const j = randInt(i + 1); [out[i], out[j]] = [out[j], out[i]]; }
  $('pw').value = out.join('').slice(0, len);
  $('msg').textContent = len >= 16 ? 'Strong length.' : 'Consider 16 or more characters.';
}
$('go').onclick = gen; $('copy').onclick = () => copyText($('pw').value, $('copy')); gen();
</script>
