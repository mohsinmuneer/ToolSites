@{
    var faqs = new List<FaqItem>
    {
        new("Is there a page limit?", "This tool converts up to 30 pages per run to keep your browser fast."),
        new("Why is my JPG large?", "Higher quality settings create larger files. Choose Standard to reduce size."),
        new("Are my files uploaded?", "No. Conversion happens in your browser.")
    };
}
<h1>@ViewData["H1"]</h1>
<div class="card">
<div class="row"><input id="f" type="file" accept="application/pdf"><label>Quality <select id="sc"><option value="1.5">Standard</option><option value="2" selected>High</option><option value="3">Very high</option></select></label><button id="go" type="button">Convert</button></div><div id="links"></div><div id="out" class="result" aria-live="polite"></div>
</div>

<partial name="_AdSlot" model='"SlotTop"' />

<div class="card">
  <h2>How to use the PDF to JPG Converter</h2>
  <p>Choose a PDF, pick an image quality and press Convert. Each page becomes a separate JPG, and a download link appears for every page.</p>
  <h2>About this tool</h2>
  <p>Each PDF page is drawn onto a canvas and saved as a JPG. Higher quality settings give sharper text but larger files. To keep your browser responsive, the tool converts up to 30 pages at a time. Because PDFs often contain text, JPG is not ideal for small print, and password-protected files cannot be converted until they are unlocked. Everything runs on your device.</p>
  <partial name="_Faq" model="faqs" />
</div>
<partial name="_RelatedTools" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous"></script>
<script>
on('go',async()=>{const f=$('f').files[0]; $('links').textContent=''; if(!f) return fail('out','Please choose a PDF.'); if(typeof pdfjsLib==='undefined') return fail('out','The PDF library could not load. Check your connection.');
try{pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const pdf=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise, n=Math.min(pdf.numPages,30), sc=parseFloat($('sc').value);
for(let i=1;i<=n;i++){show('out','Converting page '+i+' of '+n+'...'); const pg=await pdf.getPage(i), vp=pg.getViewport({scale:sc}), c=document.createElement('canvas'); c.width=vp.width; c.height=vp.height; const x=c.getContext('2d'); x.fillStyle='#fff'; x.fillRect(0,0,c.width,c.height); await pg.render({canvasContext:x,viewport:vp}).promise;
const b=await canvasBlob(c,'image/jpeg',0.92); addLink('links',b,baseName(f)+'-page-'+i+'.jpg','Download page '+i+' ('+kb(b.size)+')');}
show('out','Done'+(pdf.numPages>n?'. Only the first '+n+' pages were converted.':''));}catch(e){fail('out','Could not convert this PDF. It may be password protected or damaged.');}});
</script>
