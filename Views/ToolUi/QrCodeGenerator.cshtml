@model ToolDefinition
<p>Enter a link or short plain text, generate a QR code, then download the PNG.</p>
<form id="tool-inputs" class="batch-tool" novalidate>
  <label for="source">Link or plain text</label>
  <textarea id="source" rows="3" spellcheck="false">https://example.com</textarea>
  <div class="row">
    <button type="submit">Generate QR code</button>
    <button class="secondary" type="reset">Reset</button>
  </div>
</form>
<p class="muted">Your input stays in your browser.</p>
<div id="out" class="result" aria-live="polite"></div>
<div id="qr-preview" role="img" aria-label="Generated QR code"></div>
<a id="qr-download" download="qr-code.png" hidden>Download QR code PNG</a>
<style>
.batch-tool { display: grid; gap: 4px; }
.batch-tool input, .batch-tool select, .batch-tool textarea { width: 100%; min-height: 44px; margin-bottom: 8px; }
.batch-tool textarea { font: inherit; resize: vertical; }
.batch-tool button { min-height: 44px; }
#out { overflow-wrap: anywhere; }
#qr-preview canvas { max-width: 100%; height: auto; }
</style>
<script>
qrcode.stringToBytes = value => new TextEncoder().encode(value);

function clearQr() {
  $('qr-preview').replaceChildren();
  $('qr-download').hidden = true;
  $('qr-download').removeAttribute('href');
}

function calculate() {
  const value = $('source').value;
  if (!value.trim()) throw new Error('Enter a link or some text.');
  if (new TextEncoder().encode(value).length > 500) throw new Error('Shorten your text to 500 bytes or fewer.');
  const code = qrcode(0, 'M');
  code.addData(value, 'Byte');
  code.make();
  const size = code.getModuleCount(), margin = 4, scale = 6;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = (size + 2 * margin) * scale;
  const context = canvas.getContext('2d');
  context.fillStyle = '#fff';
  context.fillRect(0, 0, canvas.width, canvas.height);
  context.fillStyle = '#000';
  for (let row = 0; row < size; row++) {
    for (let col = 0; col < size; col++) {
      if (code.isDark(row, col)) context.fillRect((col + margin) * scale, (row + margin) * scale, scale, scale);
    }
  }
  $('qr-preview').replaceChildren(canvas);
  $('qr-download').href = canvas.toDataURL('image/png');
  $('qr-download').hidden = false;
  return ['QR code ready.'];
}

$('tool-inputs').addEventListener('submit', event => {
  event.preventDefault();
  clearQr();
  try {
    show('out', calculate());
  } catch (error) {
    show('out', error.message, false);
  }
});

$('tool-inputs').addEventListener('reset', () => {
  $('out').textContent = '';
  clearQr();
});
</script>
