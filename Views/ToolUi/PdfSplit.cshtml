@model ToolDefinition
<p>Choose a PDF and enter page positions, or select the option to save every page separately.</p>
<div class="row"><label>PDF to split <input id="f" type="file" accept="application/pdf"></label></div>
<div class="row"><label>Mode <select id="mode"><option value="range">Extract pages into one PDF</option><option value="each">Split every page into its own PDF</option></select></label>
<label id="rl">Pages <input id="rng" type="text" placeholder="1-3,5,8-10" value="1"></label></div>
<button id="go" type="button">Split PDF</button>
<div id="out" class="result" aria-live="polite"></div><ul id="links"></ul>
<p class="muted">Your files stay in your browser.</p>
<script>
$('mode').onchange = () => { $('rl').hidden = $('mode').value === 'each'; };
function parseRange(s, max) {
  const set = new Set();
  for (const part of s.split(',')) {
    const m = part.trim().match(/^(\d+)(?:\s*-\s*(\d+))?$/); if (!m) return null;
    let a = +m[1], b = m[2] ? +m[2] : a; if (a > b) [a, b] = [b, a];
    if (a < 1 || b > max) return null; for (let i = a; i <= b; i++) set.add(i - 1);
  }
  return [...set].sort((x, y) => x - y);
}
$('go').onclick = async () => {
  const file = $('f').files[0]; if (!file) { show('out', 'Choose a PDF first.', false); return; }
  if (file.size > 100 * 1048576) { show('out', 'File is over 100 MB.', false); return; }
  $('links').textContent = '';
  $('go').disabled = true;
  show('out', 'Opening PDF...', false);
  try {
    await loadToolLibraries();
    const src = await PDFLib.PDFDocument.load(await readBytes(file)), n = src.getPageCount();
    if ($('mode').value === 'each') {
      if (n > 50) { show('out', 'This PDF has ' + n + ' pages. Use the extract mode for files over 50 pages.', false); return; }
      for (let i = 0; i < n; i++) { const d = await PDFLib.PDFDocument.create(); (await d.copyPages(src, [i])).forEach(p => d.addPage(p));
        addLink('links', new Blob([await d.save()], { type: 'application/pdf' }), 'page-' + (i + 1) + '.pdf'); }
      show('out', n + ' files created. Click a link to download.', false); return;
    }
    const idx = parseRange($('rng').value, n); if (!idx || !idx.length) { show('out', 'Invalid pages. This PDF has ' + n + ' pages. Example: 1-3,5', false); return; }
    const d = await PDFLib.PDFDocument.create(); (await d.copyPages(src, idx)).forEach(p => d.addPage(p));
    download(new Blob([await d.save()], { type: 'application/pdf' }), 'extracted-pages.pdf'); show('out', idx.length + ' pages extracted.', false);
  } catch (e) { show('out', 'Could not read this PDF. It may be damaged or password-protected, or the PDF tools may have failed to load.', false); }
  finally { $('go').disabled = false; }
};
</script>
