@model ToolDefinition
<p>Enter a URL component and choose whether to encode or decode it.</p>
<form id="tool-inputs" class="batch-tool" novalidate>
  <label for="source">URL component</label>
  <textarea id="source" rows="3" spellcheck="false">cats &amp; dogs</textarea>
  <label for="operation">Operation</label>
  <select id="operation"><option>Encode</option><option>Decode</option></select>
  <div class="row">
    <button type="submit">Convert URL component</button>
    <button class="secondary" type="reset">Reset</button>
  </div>
</form>
<p class="muted">Your input stays in your browser.</p>
<div id="out" class="result" aria-live="polite"></div>
<style>
.batch-tool { display: grid; gap: 4px; }
.batch-tool input, .batch-tool select, .batch-tool textarea { width: 100%; min-height: 44px; margin-bottom: 8px; }
.batch-tool textarea { font: inherit; resize: vertical; }
.batch-tool button { min-height: 44px; }
#out { overflow-wrap: anywhere; white-space: pre-wrap; }
#qr-preview canvas { max-width: 100%; height: auto; }
</style>
<script>
function calculate() {
  const value = $('source').value;
  if (!value.length) throw new Error('Enter text to encode or decode.');
  const encoding = $('operation').value === 'Encode';
  if (value.length > (encoding ? 100000 : 900000)) throw new Error('The URL component is too long. Try a shorter value.');
  try {
    return [$('operation').value === 'Encode' ? encodeURIComponent(value) : decodeURIComponent(value)];
  } catch {
    throw new Error('Check the text and use two hexadecimal digits after each encoded percent sign.');
  }
}

$('tool-inputs').addEventListener('submit', event => {
  event.preventDefault();
  try {
    show('out', calculate());
  } catch (error) {
    show('out', error.message, false);
  }
});

$('tool-inputs').addEventListener('reset', () => {
  $('out').textContent = '';
  });
</script>
